# ─── Supabase ──────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-placeholder
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-placeholder

# ─── Database (Supabase Postgres) ──────────────────────────────
# Connection pooler URL (for Prisma Client)
DATABASE_URL="postgresql://postgres:[password]@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Direct connection URL (for Prisma Migrate)
DIRECT_URL="postgresql://postgres:[password]@db.your-project.supabase.com:5432/postgres"

# ─── Razorpay (Test Mode) ─────────────────────────────────────
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# ─── JWT Authentication ───────────────────────────────────────
JWT_SECRET=devfusion-super-secret-jwt-key-2026-hackathon

# ─── Google OAuth ──────────────────────────────────────────────
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# ─── Google Gemini AI ──────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_placeholder

# ─── App Configuration ─────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=VendorVerse

# ─── Seed Admin Credentials (for test accounts) ───────────────
SEED_ADMIN_EMAIL=admin@vendorverse.com
SEED_ADMIN_PASSWORD=Admin@123456
SEED_SELLER_EMAIL=seller@vendorverse.com
SEED_SELLER_PASSWORD=Seller@123456
SEED_CUSTOMER_EMAIL=customer@vendorverse.com
SEED_CUSTOMER_PASSWORD=Customer@123456
